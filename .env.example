# speckit environment variables
# Copy to .env and fill in real values. Never commit .env.

# ── LLM backends (at least one required) ─────────────────────────────────────

# Option A: Anthropic Claude API (paid — console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Option B: Gemini via Google AI Studio (free tier — aistudio.google.com)
GEMINI_API_KEY=AIza...

# Option C: Gemini on Vertex AI (free within GCP quota)
# GEMINI_VERTEX=true
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id

# ── GitHub (needed for speckit run, speckit feature, speckit mcp) ─────────────
# Generate at: github.com/settings/tokens → New classic token → repo scope
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/your-repo

# ── Coding backend override (optional) ───────────────────────────────────────
# SPECKIT_CODING_BACKEND=auto   # auto | anthropic | gemini | vertex

# ── Slack notifications (optional) ───────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Vector DB (optional — leave blank to use local BM25 index) ───────────────
SPECKIT_VECTOR_DB_URL=
SPECKIT_VECTOR_DB_KEY=

# ── Webhook server (optional — for speckit serve) ────────────────────────────
GITHUB_WEBHOOK_SECRET=
